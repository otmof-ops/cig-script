# Start-up set: a burn of one file, the smallest unit of work the kernel does
# (#145: a one-write burn is under 7 ms). The file goes under the sample's home.
burn {
  fs.write_text("${env.get("CIGSCRIPT_HOME")}/one.txt", "x")
}
exhale "burned one file"
