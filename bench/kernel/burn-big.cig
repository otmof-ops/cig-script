# Kernel set: burn a tree of 1000 new files of 16384 bytes under the sample's home.
# The tree goes under $CIGSCRIPT_HOME/work, never into the repository.
stick root = "${env.get("CIGSCRIPT_HOME")}/work/big"
stick body = "x".repeat(16384)
burn {
  fs.mkdir(root)
  for i in 0..1000 {
    fs.write_text("${root}/f${i}.txt", body)
  }
}
exhale "burned 1000 files of 16384 bytes"
