# A script of 500 lines, for the time a first run takes on each engine
# (cig-script#254): 41 small functions of three shapes, each called once.
# Not one of the benchmark programs.
pull step_00(n) {
  roll acc = 0
  for k in range(n) {
    if k % 2 == 0 {
      acc += k
    } else {
      acc -= 1
    }
  }
  snuff acc
}
pull step_01(n) {
  roll words = []
  for k in range(n) {
    words.push("w${k + 1}")
  }
  stick joined = words.join("-")
  if joined.len() > 4 {
    snuff joined.len()
  }
  snuff 0
}
pull step_02(n) {
  roll seen = {}
  for k in range(n) {
    seen["k${k % 3}"] = k + 2
  }
  roll total = 0
  for key in seen {
    total += seen[key]
  }
  snuff total
}
