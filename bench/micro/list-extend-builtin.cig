# list.extend (#255): append every element of ys to xs in place, sized
# once. Paired with list-extend-loop.cig. Prints the same value.
stick seed = [1, 2, 3, 4, 5, 6, 7, 8]
roll acc = []
for _ in 0..250000 {
  acc.extend(seed)
}
exhale acc.len()
