# map.inc (#255): one lookup, not three. Paired with map-inc-loop.cig.
# Prints the same value.
roll parts = []
for i in 0..300000 {
  parts.push("w${(i * 7919) % 997}")
}
roll counts = {}
for w in parts {
  counts.inc(w)
}
exhale counts.len()
