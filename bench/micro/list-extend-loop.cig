# The loop list.extend replaces: `push` for every element of another
# list. Paired with list-extend-builtin.cig (#255). Needs
# CIG_MAX_STEPS=0.
stick seed = [1, 2, 3, 4, 5, 6, 7, 8]
roll acc = []
for _ in 0..250000 {
  for v in seed {
    acc.push(v)
  }
}
exhale acc.len()
