# The loop list.counts replaces: a tally of each value in a list, kept
# with `has`, a read and a write. Paired with counts-builtin.cig
# (#255). Same words bench/compute/words.cig builds. Needs
# CIG_MAX_STEPS=0.
roll parts = []
for i in 0..300000 {
  parts.push("w${(i * 7919) % 997}")
}
roll counts = {}
for w in parts {
  if counts.has(w) {
    counts[w] = counts[w] + 1
  } else {
    counts[w] = 1
  }
}
exhale counts.len()
