roll items = [1, 2, 3]
pull add(a, b) {
  snuff a + b
}
try {
  exhale add(1, "x")
} ashtray e {
  exhale e.message
}
try {
  exhale items.nope()
} ashtray e {
  exhale e.message
}
exhale add(1)
